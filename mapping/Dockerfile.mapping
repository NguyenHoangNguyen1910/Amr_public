FROM px4io/px4-sitl-gazebo:latest AS rtabmap-builder

ARG RTABMAP_VERSION=0.23.2

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        cppzmq-dev \
        git \
        libeigen3-dev \
        libflann-dev \
        libgz-msgs10-dev \
        libgz-transport13-dev \
        libopencv-dev \
        libpcl-dev \
        libsqlite3-dev \
        libyaml-cpp-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

# This is the expensive layer. It is before all repository mapping sources so
# changing a mapper C++ file does not rebuild RTAB-Map itself.
RUN git clone --depth 1 --branch "${RTABMAP_VERSION}" \
        https://github.com/introlab/rtabmap.git /tmp/rtabmap \
    && cmake -S /tmp/rtabmap -B /tmp/rtabmap/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DWITH_QT=OFF \
        -DBUILD_APP=OFF \
        -DBUILD_TOOLS=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DWITH_PDAL=OFF \
        -DWITH_FREENECT=OFF \
        -DWITH_FREENECT2=OFF \
        -DWITH_K4W2=OFF \
        -DWITH_K4A=OFF \
        -DWITH_OPENNI=OFF \
        -DWITH_OPENNI2=OFF \
        -DWITH_DC1394=OFF \
        -DWITH_FLYCAPTURE2=OFF \
        -DWITH_ZED=OFF \
        -DWITH_ZEDOC=OFF \
        -DWITH_REALSENSE=OFF \
        -DWITH_REALSENSE_SLAM=OFF \
        -DWITH_REALSENSE2=OFF \
        -DWITH_MYNTEYE=OFF \
        -DWITH_MRPT=OFF \
        -DWITH_POINTMATCHER=OFF \
        -DWITH_OPENGV=OFF \
        -DWITH_G2O=OFF \
        -DWITH_GTSAM=OFF \
        -DWITH_CERES=OFF \
        -DWITH_OPEN3D=OFF \
        -DWITH_OCTOMAP=OFF \
        -DWITH_MADGWICK=OFF \
        -DWITH_FASTCV=OFF \
    && cmake --build /tmp/rtabmap/build --parallel 2 \
    && cmake --install /tmp/rtabmap/build \
    && rm -rf /tmp/rtabmap

FROM rtabmap-builder AS mapper-builder

# Keep this COPY limited to C++ build inputs. Python/API edits do not trigger a
# compiler invocation, and RTAB-Map remains in the parent layer cache.
COPY src/mapping/CMakeLists.txt \
     src/mapping/rtabmap_mapper.cpp \
     src/mapping/rtabmap_db_check.cpp \
     /tmp/drone_mapping/
RUN cmake -S /tmp/drone_mapping -B /tmp/drone_mapping/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
    && cmake --build /tmp/drone_mapping/build --parallel 2 \
    && cmake --install /tmp/drone_mapping/build \
    && rm -rf /tmp/drone_mapping

FROM px4io/px4-sitl-gazebo:latest

COPY --from=ghcr.io/astral-sh/uv:0.12.17 /uv /uvx /bin/

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libflann1.9 \
        libopencv-calib3d406t64 \
        libopencv-contrib406t64 \
        libopencv-features2d406t64 \
        libopencv-highgui406t64 \
        libopencv-imgcodecs406t64 \
        libopencv-photo406t64 \
        libopencv-stitching406t64 \
        libopencv-videoio406t64 \
        libpcl-common1.14 \
        libpcl-features1.14 \
        libpcl-filters1.14 \
        libpcl-io1.14 \
        libpcl-kdtree1.14 \
        libpcl-ml1.14 \
        libpcl-octree1.14 \
        libpcl-registration1.14 \
        libpcl-sample-consensus1.14 \
        libpcl-search1.14 \
        libpcl-segmentation1.14 \
        libpcl-surface1.14 \
        libyaml-cpp0.8 \
    && rm -rf /var/lib/apt/lists/*

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/project/src \
    RTABMAP_CONFIG=/opt/mapping/rtabmap.ini

WORKDIR /workspace/project
RUN uv venv --python /usr/bin/python3 --system-site-packages /opt/venv
COPY src/mapping/requirements.txt /tmp/mapping-requirements.txt
RUN uv pip install --python /opt/venv/bin/python --no-cache -r /tmp/mapping-requirements.txt

# C++ outputs come after Python dependencies. A mapper C++ edit therefore
# invalidates only the artifact-copy/ldconfig tail, not the API environment.
COPY --from=mapper-builder /usr/local/bin/rtabmap_mapper /usr/local/bin/rtabmap_mapper
COPY --from=mapper-builder /usr/local/bin/rtabmap_db_check /usr/local/bin/rtabmap_db_check
COPY --from=mapper-builder /usr/local/lib/librtabmap_core.so* /usr/local/lib/
COPY --from=mapper-builder /usr/local/lib/librtabmap_utilite.so* /usr/local/lib/
RUN ldconfig

# These Python files are intentionally copied after dependencies and C++ build.
COPY src/config.py /workspace/project/src/config.py
COPY src/mapping/__init__.py src/mapping/service.py /workspace/project/src/mapping/
COPY src/navigation/__init__.py src/navigation/map_io.py /workspace/project/src/navigation/
COPY src/mapping/rtabmap.ini /opt/mapping/rtabmap.ini

EXPOSE 8001

ENTRYPOINT []
CMD ["python", "-m", "mapping.service"]
